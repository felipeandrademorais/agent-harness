# Telegram Bot
TELEGRAM_TOKEN=your_bot_token_here
# Comma-separated list of allowed Telegram user IDs
ALLOWED_USER_IDS=123456789,987654321

# PostgreSQL (Docker on port 5455)
DATABASE_URL=postgresql://harness:harness@localhost:5455/harness

# Ollama (default LLM provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama_chat/llama3.1

# Optional: override model per agent (e.g. use a larger model for orchestration)
# ORCHESTRATOR_MODEL=ollama_chat/qwen2.5:14b

# Future providers (uncomment and fill in to use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# MCP server commands (optional — agents fall back to stub if not set)
# MCP_ADO_COMMAND=python -m mcp_ado_server
# MCP_GITLAB_COMMAND=python -m mcp_gitlab_server
# MCP_POSTGRES_COMMAND=python -m mcp_postgres_server
